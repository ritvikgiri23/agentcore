# Copy to `.env` and adjust. Every setting is optional: the defaults below are
# what the app uses when the variable is unset. Docker Compose overrides the
# DATABASE_URL / TEST_DATABASE_URL / REDIS_URL hosts to point at its services.

# --- General ---------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Host ports published by docker compose (Postgres/Redis only with the dev override).
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Infrastructure --------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://agentcore:agentcore@localhost:5432/agentcore
# Dedicated database used by the test suite (created by the Postgres init script).
TEST_DATABASE_URL=postgresql+asyncpg://agentcore:agentcore@localhost:5432/agentcore_test
REDIS_URL=redis://localhost:6379/0

# --- Auth ------------------------------------------------------------------
# CHANGE THIS outside local development; the app refuses to start in production with the default.
JWT_SECRET=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
# Access-token lifetime in minutes.
JWT_EXPIRE_MINUTES=30

# --- LLM provider ----------------------------------------------------------
# Leave empty to run with the deterministic fake LLM and embedder.
OPENAI_API_KEY=
# openai | fake. Defaults to `openai` when OPENAI_API_KEY is set, else `fake`.
LLM_PROVIDER=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Agent loop ------------------------------------------------------------
# Safety cap on LLM iterations per run.
MAX_ITERATIONS=10
# Per-tool-call timeout.
TOOL_TIMEOUT_SECONDS=5
# Tool results longer than this are truncated in steps and stream events.
TOOL_RESULT_MAX_CHARS=4096

# --- Memory ----------------------------------------------------------------
# Short-term messages used as context (5 turns = 10 messages).
SHORT_TERM_CONTEXT_MESSAGES=10
# Short-term turns retained per session in Redis.
SHORT_TERM_RETAINED_TURNS=20
# Long-term memories retrieved per run.
LONG_TERM_TOP_K=3
# Cosine distance (0..2) beyond which retrieved memories are ignored.
MEMORY_MAX_DISTANCE=1.0
# Cosine distance under which a new fact counts as already remembered.
MEMORY_DEDUP_DISTANCE=0.05

# --- Runs ------------------------------------------------------------------
# Queued + running runs allowed per user before 429.
MAX_ACTIVE_RUNS_PER_USER=10
# Worker heartbeat lease; a running run whose lease expires is considered lost.
RUN_LEASE_TTL_SECONDS=120
